EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Backend web de Wayio (Next.js): IA (generate, adjust, reschedule, validate,
# interpret, analyze-video), búsquedas (hotels, activities, flights) y pagos.
# Todas las llamadas llevan Authorization: Bearer <token de Supabase>.
# En un teléfono físico usa la IP LAN de tu PC, NO localhost,
# p. ej. http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Web pública: recuperar contraseña, páginas legales y enlaces para compartir
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Reservas con depósito (15 %). Apagadas por defecto; actívalas solo si el
# servidor cobra con Stripe y tiene NEXT_PUBLIC_RESERVAS_ENABLED=true (si no,
# responde 403; con Creem no existen).
EXPO_PUBLIC_RESERVAS_ENABLED=false

# Compras dentro de la app (App Store y Google Play vía RevenueCat): basta con
# poner la clave PÚBLICA de RevenueCat de cada plataforma (Project settings →
# API keys). Con la clave, esa plataforma vende Pro con la tienda en vez del
# pago web; sin ella, sigue con el pago web. Hace falta un development build
# (no Expo Go). Guía: API-KEYS-GUIA.md, sección 6b.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# 'false' fuerza el pago web aunque haya clave (vacío = automático).
EXPO_PUBLIC_COMPRAS_TIENDA=
# Opcionales, solo si en RevenueCat usas otros identificadores:
# entitlement de Pro (por defecto pro), oferta (vacío = la marcada como
# actual) y paquete a medida del pase (por defecto pase_30_dias).
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=
EXPO_PUBLIC_REVENUECAT_OFERTA=
EXPO_PUBLIC_REVENUECAT_PAQUETE_PASE=
# Solo iOS: 'true' ofrece ADEMÁS «Pagar en la web» si la cuenta del App Store
# es de EE. UU. (allí Apple lo permite). En Android no se ofrece: Google exige
# inscribirse en su programa de ofertas externas y pagarle comisión.
EXPO_PUBLIC_CHECKOUT_WEB_EEUU=false

# Proveedor de geocodificación del backend, para los créditos del mapa. Por
# defecto (vacío o 'geoapify') el mapa muestra «Powered by Geoapify», que el
# plan Free de Geoapify exige donde se ven sus coordenadas. Pon 'osm' solo si
# el servidor NO tiene GEOAPIFY_API_KEY (usa Nominatim + OSRM).
EXPO_PUBLIC_GEO_PROVEEDOR=

# Afiliados: los MISMOS IDs que las NEXT_PUBLIC_* de la web. La app los usa en
# los enlaces de respaldo (si el backend no responde), en «Reservar» y «Ver
# hotel» de cada actividad, y en la eSIM y el seguro.
# Si falta uno, el enlace funciona igual pero sin comisión (eSIM y seguro no se
# muestran sin su ID). Son públicos: van dentro de la app.
# Booking.com exige aprobación por escrito para usarlo con IA: déjalo vacío
# hasta tenerla.
EXPO_PUBLIC_BOOKING_AID=
# Actividades: Viator (PID y MCID, los dos) → Civitatis → GetYourGuide.
EXPO_PUBLIC_VIATOR_PID=
EXPO_PUBLIC_VIATOR_MCID=
EXPO_PUBLIC_CIVITATIS_AID=
EXPO_PUBLIC_GYG_PARTNER_ID=
EXPO_PUBLIC_SKYSCANNER_ASSOCIATE_ID=
# Travelpayouts: marker (ID de socio) y, opcional, trs (ID del proyecto).
EXPO_PUBLIC_TP_MARKER=
EXPO_PUBLIC_TP_TRS=
# true cuando el programa Trip.com esté conectado a tu proyecto de
# Travelpayouts: los hoteles pasan a Trip.com (5,5 %).
EXPO_PUBLIC_TP_TRIPCOM=false
EXPO_PUBLIC_DISCOVERCARS_AID=
EXPO_PUBLIC_AIRALO_REF=
EXPO_PUBLIC_IATI_REF=

# Analítica (clics de afiliado): la MISMA clave pública de PostHog que
# NEXT_PUBLIC_POSTHOG_KEY. Sin clave no se envía nada. No manda datos
# personales ni el token de sesión.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
