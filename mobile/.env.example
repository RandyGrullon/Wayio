EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Backend web de Wayio (Next.js): IA (generate, adjust, reschedule, validate,
# interpret, analyze-video), búsquedas (hotels, activities, flights) y Stripe.
# Todas las llamadas llevan Authorization: Bearer <token de Supabase>.
# En un teléfono físico usa la IP LAN de tu PC, NO localhost,
# p. ej. http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Web pública: recuperar contraseña, páginas legales y enlaces para compartir
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Reservas con depósito (15 %) vía Stripe. Apagadas por defecto; actívalas solo
# si el servidor tiene NEXT_PUBLIC_RESERVAS_ENABLED=true (si no, responde 403).
EXPO_PUBLIC_RESERVAS_ENABLED=false

# Proveedor de geocodificación del backend, para los créditos del mapa. Por
# defecto (vacío o 'geoapify') el mapa muestra «Powered by Geoapify», que el
# plan Free de Geoapify exige donde se ven sus coordenadas. Pon 'osm' solo si
# el servidor NO tiene GEOAPIFY_API_KEY (usa Nominatim + OSRM).
EXPO_PUBLIC_GEO_PROVEEDOR=

# Afiliados: los MISMOS IDs que las NEXT_PUBLIC_* de la web. La app los usa en
# los enlaces de respaldo (si el backend no responde) y en la eSIM y el seguro.
# Si falta uno, el enlace funciona igual pero sin comisión (eSIM y seguro no se
# muestran sin su ID). Son públicos: van dentro de la app.
# Booking.com exige aprobación por escrito para usarlo con IA: déjalo vacío
# hasta tenerla.
EXPO_PUBLIC_BOOKING_AID=
EXPO_PUBLIC_SKYSCANNER_ASSOCIATE_ID=
# Travelpayouts: marker (ID de socio) y, opcional, trs (ID del proyecto).
EXPO_PUBLIC_TP_MARKER=
EXPO_PUBLIC_TP_TRS=
# true cuando el programa Trip.com esté conectado a tu proyecto de
# Travelpayouts: los hoteles pasan a Trip.com (5,5 %).
EXPO_PUBLIC_TP_TRIPCOM=false
EXPO_PUBLIC_DISCOVERCARS_AID=
EXPO_PUBLIC_AIRALO_REF=
EXPO_PUBLIC_IATI_REF=
