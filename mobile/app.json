{
  "expo": {
    "name": "Wayio",
    "slug": "wayio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wayio",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F4EE",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wayio.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wayio usa tu ubicación para detectar cuando llegas a cada actividad.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Wayio necesita acceso a tu ubicación en segundo plano para el geofencing automático.",
        "NSLocationAlwaysUsageDescription": "Wayio necesita acceso a tu ubicación en segundo plano para el geofencing automático."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#142435",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.wayio.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Wayio necesita acceso a tu ubicación en segundo plano para el geofencing automático.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#C21A66"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-punto.png",
          "imageWidth": 20,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EE",
          "dark": {
            "image": "./assets/splash-punto-dark.png",
            "backgroundColor": "#0B1622"
          }
        }
      ],
      "@rnmapbox/maps",
      "expo-web-browser",
      "expo-font"
    ]
  }
}
