# =============================================================================
# Wayio — variables de entorno
# =============================================================================
# Copia este archivo como .env.local (desarrollo) y pon las mismas variables en
# Vercel (Settings → Environment Variables) para producción.
#
# MODO DEMO: sin ninguna variable la app funciona con un itinerario de ejemplo
# (Tokio), sin login ni pagos. Ve añadiendo claves según las funciones que
# quieras activar. Todo lo que no esté configurado se desactiva sin errores.
#
# Las variables NEXT_PUBLIC_* se incrustan en el navegador al compilar: nunca
# pongas ahí un secreto, y vuelve a desplegar después de cambiarlas.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# URL pública sin barra final. Se usa en metadata, sitemap, robots, JSON-LD,
# correos de autenticación y URLs de retorno de Stripe. En Vercel, si falta, se
# usa la URL del despliegue.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Email público de contacto que muestra /contacto. Si falta o no es válido, la
# página dice que el canal llega pronto (no muestra un botón roto).
NEXT_PUBLIC_CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# Supabase (login, guardar viajes, grupos, panel admin)
# -----------------------------------------------------------------------------
# Supabase → Project Settings → API. Sin esto = modo demo sin sesión.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETO (solo servidor): caché de viajes, métricas de IA, webhooks y admin.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Inteligencia artificial
# -----------------------------------------------------------------------------
# Proveedor: 'anthropic' (Claude, producción) o 'groq' (gratis, para pruebas).
AI_PROVIDER=anthropic
# SECRETO: console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Opcionales: modelos por tarea. Por defecto el itinerario y los ajustes usan
# claude-opus-5-5 y las tareas rápidas (interpretar, alertas) claude-haiku-5-5.
# AI_ITINERARY_MODEL=claude-opus-5-5
# AI_FAST_MODEL=claude-haiku-5-5
# AI_VISION_MODEL=claude-opus-5-5
# Opcionales: esfuerzo de razonamiento (low | medium | high). Menos esfuerzo =
# más rápido y barato. Por defecto: medium para el itinerario, los ajustes y el
# análisis de imágenes; low para las tareas rápidas. AI_ITINERARY_EFFORT solo
# afecta al itinerario; AI_EFFORT, a todas las demás tareas.
# AI_ITINERARY_EFFORT=medium
# AI_EFFORT=low

# SECRETO: console.groq.com → API Keys (solo si AI_PROVIDER=groq).
GROQ_API_KEY=
# Modelos vigentes de Groq (los llama-3.x y llama-4-scout se dieron de baja).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Análisis de videos de TikTok/Instagram (necesita yt-dlp y ffmpeg en el
# servidor). 'true' lo activa, 'false' lo desactiva; vacío = activo solo en
# desarrollo (en serverless no suele haber ffmpeg).
VIDEO_ANALYSIS_ENABLED=
# Opcional: ruta a un ffmpeg del sistema (si no, se usa @ffmpeg-installer).
# FFMPEG_PATH=

# -----------------------------------------------------------------------------
# Límites de uso (rate limit)
# -----------------------------------------------------------------------------
# Upstash Redis (plan gratis en upstash.com → Redis → REST API). Hace que los
# límites por usuario/IP y el ritmo de Nominatim sean globales entre todas las
# instancias serverless. Sin esto se limita en memoria por instancia.
UPSTASH_REDIS_REST_URL=
# SECRETO.
UPSTASH_REDIS_REST_TOKEN=
# En desarrollo los límites de las rutas de IA están apagados; 'true' los
# activa para probarlos en local.
RATE_LIMIT_ENFORCE=

# -----------------------------------------------------------------------------
# Mapas, geocodificación y clima
# -----------------------------------------------------------------------------
# El mapa usa MapLibre + OpenFreeMap y la geocodificación OpenStreetMap
# Nominatim: gratis y sin clave.
# Email de contacto que Nominatim pide en su política de uso (recomendado).
NOMINATIM_EMAIL=
# SECRETO (opcional): openweathermap.org → API keys. Clima del destino en el
# itinerario; la clave nueva puede tardar hasta 2 h en activarse.
OPENWEATHER_API_KEY=
# Rutas exactas por calles entre paradas (a pie y en carro): OSRM sobre datos
# de OpenStreetMap. Por defecto, los servidores públicos de FOSSGIS
# (routing.openstreetmap.de), gratis y sin clave pero de uso justo. Con mucho
# tráfico, monta tu propio OSRM (Docker) y pon aquí sus URL base, sin barra
# final y con el perfil incluido. Si el servicio falla, el mapa dibuja arcos.
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
# OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving

# -----------------------------------------------------------------------------
# Búsqueda de actividades con precio (Viator Partner API v2)
# -----------------------------------------------------------------------------
# SECRETO: alta como afiliado en partnerresources.viator.com ("Basic Access").
# Sin clave, /api/activities responde configured:false y enlaza a Viator.
VIATOR_API_KEY=
# Opcional: para pruebas usa el sandbox https://api.sandbox.viator.com/partner
# VIATOR_API_URL=https://api.viator.com/partner
# Vuelos y hoteles no tienen proveedor de precios en tiempo real (Amadeus
# Self-Service cerró y la API de Booking exige contrato): se usan enlaces de
# afiliado con las fechas ya puestas.

# -----------------------------------------------------------------------------
# Afiliados (enlaces que generan comisión). Públicos: van en el navegador.
# -----------------------------------------------------------------------------
# Si falta un ID, el enlace funciona igual pero sin comisión.
# Booking.com (hoteles y carros): "aid" del programa de afiliados (Awin/CJ).
NEXT_PUBLIC_BOOKING_AID=
# Viator (actividades): PID y MCID del panel de afiliado (los dos hacen falta).
NEXT_PUBLIC_VIATOR_PID=
NEXT_PUBLIC_VIATOR_MCID=
# Skyscanner (vuelos), programa vía Impact.
NEXT_PUBLIC_SKYSCANNER_ASSOCIATE_ID=
# Travelpayouts: si no hay ID de Skyscanner, los vuelos van a Aviasales con
# este marker.
NEXT_PUBLIC_TP_MARKER=
# Airalo (eSIM): código de referido.
NEXT_PUBLIC_AIRALO_REF=

# -----------------------------------------------------------------------------
# Pagos (Stripe)
# -----------------------------------------------------------------------------
# SECRETO: dashboard.stripe.com → Developers → API keys (empieza en modo test).
STRIPE_SECRET_KEY=
# SECRETO: Developers → Webhooks → endpoint /api/stripe/webhook → Signing secret.
STRIPE_WEBHOOK_SECRET=
# IDs de precio (price_...) de cada plan, creados en Products.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_PER_TRIP=
STRIPE_PRICE_GROUP=
# Pública: hoy no la usa el código (el pago es en Stripe Checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Depósito de reserva del viaje: desactivado salvo 'true' (no hay proveedor de
# reservas real detrás; actívalo solo cuando lo haya).
NEXT_PUBLIC_RESERVAS_ENABLED=false

# -----------------------------------------------------------------------------
# Analítica de producto (PostHog)
# -----------------------------------------------------------------------------
# posthog.com → Project settings → Project API key (es pública). Sin ella no se
# envía nada, ni desde el navegador ni desde el servidor.
NEXT_PUBLIC_POSTHOG_KEY=
# Región del proyecto: https://us.i.posthog.com (EE. UU.) o https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Monitorización de errores (Sentry)
# -----------------------------------------------------------------------------
# sentry.io → Project → Client Keys (DSN). Es público. Activa la captura de
# errores en el navegador y en el servidor.
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: DSN distinto solo para el servidor (si falta se usa el público).
SENTRY_DSN=
# Subida de sourcemaps en el build (errores con código legible). Hacen falta
# los tres; el token es SECRETO: Settings → Auth Tokens (scope project:releases).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
